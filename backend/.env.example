# Clé API Anthropic — obtenez-la sur https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Modèle utilisé pour la pré-analyse (modifiable)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Origine autorisée pour CORS (front Vite en dev)
CORS_ORIGIN=http://localhost:5173

# Compression PDF
MAX_PDF_PAGES=4
PDF_RENDER_DPI=120

PORT=5000
